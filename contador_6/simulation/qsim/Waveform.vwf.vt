// *****************************************************************************
// This file contains a Verilog test bench with test vectors .The test vectors  
// are exported from a vector file in the Quartus Waveform Editor and apply to  
// the top level entity of the current Quartus project .The user can use this   
// testbench to simulate his design using a third-party simulation tool .       
// *****************************************************************************
// Generated on "10/14/2026 23:48:08"
                                                                        
// Verilog Self-Checking Test Bench (with test vectors) for design :    circuito_prueba
// 
// Simulation tool : 3rd Party
// 

`timescale 1 ps/ 1 ps
module circuito_prueba_vlg_sample_tst(
	BTN,
	SW0,
	SW8,
	SW9,
	sampler_tx
);
input [1:0] BTN;
input  SW0;
input  SW8;
input  SW9;
output sampler_tx;

reg sample;
time current_time;
always @(BTN or SW0 or SW8 or SW9)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

module circuito_prueba_vlg_check_tst (
	HEX_D,
	LED_G,
	sampler_rx
);
input [6:0] HEX_D;
input [0:0] LED_G;
input sampler_rx;

reg [6:0] HEX_D_expected;
reg [0:0] LED_G_expected;

reg [6:0] HEX_D_prev;
reg [0:0] LED_G_prev;

reg [6:0] HEX_D_expected_prev;
reg [0:0] LED_G_expected_prev;

reg [6:0] last_HEX_D_exp;
reg [0:0] last_LED_G_exp;

reg trigger;

integer i;
integer nummismatches;

reg [1:2] on_first_change ;


initial
begin
trigger = 0;
i = 0;
nummismatches = 0;
on_first_change = 2'b1;
end

// update real /o prevs

always @(trigger)
begin
	HEX_D_prev = HEX_D;
	LED_G_prev = LED_G;
end

// update expected /o prevs

always @(trigger)
begin
	HEX_D_expected_prev = HEX_D_expected;
	LED_G_expected_prev = LED_G_expected;
end


// expected HEX_D[ 6 ]
initial
begin
	HEX_D_expected[6] = 1'bX;
end 
// expected HEX_D[ 5 ]
initial
begin
	HEX_D_expected[5] = 1'bX;
end 
// expected HEX_D[ 4 ]
initial
begin
	HEX_D_expected[4] = 1'bX;
end 
// expected HEX_D[ 3 ]
initial
begin
	HEX_D_expected[3] = 1'bX;
end 
// expected HEX_D[ 2 ]
initial
begin
	HEX_D_expected[2] = 1'bX;
end 
// expected HEX_D[ 1 ]
initial
begin
	HEX_D_expected[1] = 1'bX;
end 
// expected HEX_D[ 0 ]
initial
begin
	HEX_D_expected[0] = 1'bX;
end 

// expected LED_G[0]
initial
begin
	LED_G_expected[0] = 1'bX;
end 
// generate trigger
always @(HEX_D_expected or HEX_D or LED_G_expected or LED_G)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected HEX_D = %b | expected LED_G = %b | ",HEX_D_expected_prev,LED_G_expected_prev);
	$display("| real HEX_D = %b | real LED_G = %b | ",HEX_D_prev,LED_G_prev);
`endif
	if (
		( HEX_D_expected_prev[0] !== 1'bx ) && ( HEX_D_prev[0] !== HEX_D_expected_prev[0] )
		&& ((HEX_D_expected_prev[0] !== last_HEX_D_exp[0]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port HEX_D[0] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", HEX_D_expected_prev);
		$display ("     Real value = %b", HEX_D_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_HEX_D_exp[0] = HEX_D_expected_prev[0];
	end
	if (
		( HEX_D_expected_prev[1] !== 1'bx ) && ( HEX_D_prev[1] !== HEX_D_expected_prev[1] )
		&& ((HEX_D_expected_prev[1] !== last_HEX_D_exp[1]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port HEX_D[1] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", HEX_D_expected_prev);
		$display ("     Real value = %b", HEX_D_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_HEX_D_exp[1] = HEX_D_expected_prev[1];
	end
	if (
		( HEX_D_expected_prev[2] !== 1'bx ) && ( HEX_D_prev[2] !== HEX_D_expected_prev[2] )
		&& ((HEX_D_expected_prev[2] !== last_HEX_D_exp[2]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port HEX_D[2] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", HEX_D_expected_prev);
		$display ("     Real value = %b", HEX_D_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_HEX_D_exp[2] = HEX_D_expected_prev[2];
	end
	if (
		( HEX_D_expected_prev[3] !== 1'bx ) && ( HEX_D_prev[3] !== HEX_D_expected_prev[3] )
		&& ((HEX_D_expected_prev[3] !== last_HEX_D_exp[3]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port HEX_D[3] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", HEX_D_expected_prev);
		$display ("     Real value = %b", HEX_D_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_HEX_D_exp[3] = HEX_D_expected_prev[3];
	end
	if (
		( HEX_D_expected_prev[4] !== 1'bx ) && ( HEX_D_prev[4] !== HEX_D_expected_prev[4] )
		&& ((HEX_D_expected_prev[4] !== last_HEX_D_exp[4]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port HEX_D[4] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", HEX_D_expected_prev);
		$display ("     Real value = %b", HEX_D_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_HEX_D_exp[4] = HEX_D_expected_prev[4];
	end
	if (
		( HEX_D_expected_prev[5] !== 1'bx ) && ( HEX_D_prev[5] !== HEX_D_expected_prev[5] )
		&& ((HEX_D_expected_prev[5] !== last_HEX_D_exp[5]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port HEX_D[5] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", HEX_D_expected_prev);
		$display ("     Real value = %b", HEX_D_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_HEX_D_exp[5] = HEX_D_expected_prev[5];
	end
	if (
		( HEX_D_expected_prev[6] !== 1'bx ) && ( HEX_D_prev[6] !== HEX_D_expected_prev[6] )
		&& ((HEX_D_expected_prev[6] !== last_HEX_D_exp[6]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port HEX_D[6] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", HEX_D_expected_prev);
		$display ("     Real value = %b", HEX_D_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_HEX_D_exp[6] = HEX_D_expected_prev[6];
	end
	if (
		( LED_G_expected_prev !== 1'bx ) && ( LED_G_prev !== LED_G_expected_prev )
		&& ((LED_G_expected_prev !== last_LED_G_exp) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port LED_G :: @time = %t",  $realtime);
		$display ("     Expected value = %b", LED_G_expected_prev);
		$display ("     Real value = %b", LED_G_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_LED_G_exp = LED_G_expected_prev;
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module circuito_prueba_vlg_vec_tst();
// constants                                           
// general purpose registers
reg [1:0] BTN;
reg SW0;
reg SW8;
reg SW9;
// wires                                               
wire [6:0] HEX_D;
wire [0:0] LED_G;

wire sampler;                             

// assign statements (if any)                          
circuito_prueba i1 (
// port map - connection between master ports and signals/registers   
	.BTN(BTN),
	.HEX_D(HEX_D),
	.LED_G(LED_G),
	.SW0(SW0),
	.SW8(SW8),
	.SW9(SW9)
);
// BTN[ 1 ]
always
begin
	BTN[1] = 1'b0;
	BTN[1] = #10000 1'b1;
	#10000;
end 
// BTN[ 0 ]
initial
begin
	BTN[0] = 1'b1;
	# 10000;
	repeat(49)
	begin
		BTN[0] = 1'b0;
		BTN[0] = #10000 1'b1;
		# 10000;
	end
	BTN[0] = 1'b0;
end 

// SW0
initial
begin
	SW0 = 1'b1;
end 

// SW8
initial
begin
	SW8 = 1'b1;
end 

// SW9
initial
begin
	SW9 = 1'b0;
end 

circuito_prueba_vlg_sample_tst tb_sample (
	.BTN(BTN),
	.SW0(SW0),
	.SW8(SW8),
	.SW9(SW9),
	.sampler_tx(sampler)
);

circuito_prueba_vlg_check_tst tb_out(
	.HEX_D(HEX_D),
	.LED_G(LED_G),
	.sampler_rx(sampler)
);
endmodule

